DATABASE_URL="postgresql://retiro:retiro123@localhost:5432/retiro_db?schema=public"
JWT_SECRET="troque-este-token-por-um-secreto-forte"
# Origens autorizadas no CORS. Aceita uma ou varias separadas por virgula.
# Ex: "https://app.exemplo.com,https://admin.exemplo.com"
FRONTEND_URL="http://localhost:3009"
# Opcionais (tem valores padrao): NODE_ENV, PORT, JWT_EXPIRES_IN

# Credenciais do usuário admin criado pelo seed (prisma/seed.ts).
# Em producao defina valores fortes no painel de secrets do provedor.
ADMIN_EMAIL="admin@exemplo.com"
ADMIN_SENHA="defina-uma-senha-forte"
